<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Параметры колеса SCOUT — официальные значения
         (agilexrobotics/ugv_gazebo_sim, BSD). Визуальная модель:
         meshes/wheel_type1.dae (единая для всех 4 колёс). -->
    <xacro:property name="wheel_radius" value="0.16459"/>
    <xacro:property name="wheel_length" value="0.11653"/>

    <!-- Колесо дифференциального привода: вращение вокруг оси Y, continuous.
         Ось едина для всех колёс (0 1 0) — так diff_drive_controller получает
         согласованное направление «вперёд». Параметр reflect зеркалирует
         только ВИЗУАЛЬНУЮ модель (0 = левое, 1 = правое колесо). -->
    <xacro:macro name="wheel" params="prefix parent reflect *origin">

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${parent}"/>
            <child link="${prefix}_wheel_link"/>
            <axis xyz="0 1 0"/>
            <dynamics damping="0.2"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <link name="${prefix}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="${reflect*pi} 0 0"/>
                <geometry>
                    <mesh filename="file://$(find scout_description)/meshes/wheel_type1.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="3.0"/>
                <inertia ixx="0.7171" ixy="0" ixz="0"
                         iyy="0.1361" iyz="0"
                         izz="0.7171"/>
            </inertial>
        </link>

    </xacro:macro>
</robot>
