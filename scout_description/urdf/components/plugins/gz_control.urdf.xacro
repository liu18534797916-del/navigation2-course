<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Плагин gz_ros2_control: создаёт менеджер ресурсов и менеджер
         контроллеров внутри Gazebo Harmonic. Конфигурация контроллеров
         берётся из scout_control/config/controllers.yaml. Одометрия и TF
         (odom -> base_footprint) публикуются diff_drive_controller,
         поэтому выполняется ремаппинг в пространство имён робота. -->
    <xacro:macro name="gz_control" params="namespace">

        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find scout_control)/config/controllers.yaml</parameters>

                <ros>
                    <namespace>${namespace}</namespace>
                    <!-- Имена систем координат используются без префиксов
                         (odom, base_footprint, ...); пространство имён задаётся
                         только в именах топиков: /scout/tf, /scout/tf_static,
                         /scout/odom — см. ремаппинги ниже. -->
                    <remapping>diff_drive_controller/odom:=odom</remapping>
                    <remapping>tf:=/${namespace}/tf</remapping>
                    <remapping>tf_static:=/${namespace}/tf_static</remapping>
                </ros>
            </plugin>
        </gazebo>

    </xacro:macro>

</robot>
