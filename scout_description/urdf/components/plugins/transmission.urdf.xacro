<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Мотор одного колеса дифференциального привода: принимает команду
         по скорости, публикует состояние (позиция, скорость).
         Для diff_drive_controller нужен только интерфейс velocity. -->
    <xacro:macro name="transmission" params="joint">
        <joint name="${joint}">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

</robot>
